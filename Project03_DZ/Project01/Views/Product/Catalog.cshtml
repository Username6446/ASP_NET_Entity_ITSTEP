@model IEnumerable<Product>

@{
    ViewData["Title"] = "Каталог";
}

<div style="min-height: 100vh;">
    <div class="d-flex">
        <h2 class="text-center flex-grow-1 w-100">Каталог товарів</h2>
        <div class="me-3">
            <a asp-action="Create" asp-controller="Product">
            <i class="bi bi-plus-circle" style="font-size: 1.6rem;"></i>
         </a>
        </div>
    </div>
    <h2 class="text-center">Список товарів</h2>
    <div class="container">
        <div class="row">
            @foreach (var product in Model)
            {
                <div class="col-3 p-2">
                    <div class="card h-100 p-3 card-hover">
                        <div style="height: 175px;">
                            <img class="w-100 h-100" style="object-fit: contain;" src="@product.Image" alt="@product.Name" />
                        </div>
                        <h3 class="card-header mt-1">@product.Name</h3>
                        <div class="card-body">
                            <div class="mb-2">
                                <span class="badge bg-secondary">
                                    @(product.Category?.Name ?? "Без категорії")
                                </span>
                            </div>
                            <p class="card-text">@product.Description</p>
                            <p class="fw-bold">Ціна: @product.Price грн</p>
                            <p class="text-muted">Кількість: @product.Amount шт.</p>
                        </div>
                        <div>
                            <a asp-action="Update" asp-controller="Product" asp-route-id="@product.Id" class="btn btn-success">Редагувати</a>
                            <a asp-action="Delete" asp-controller="Product" asp-route-id="@product.Id" class="btn btn-danger">Видалити</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>